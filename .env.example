# ═══════════════════════════════════════════════════════════════
#                    🌸 MIKU BOT - CONFIGURAÇÃO COMPLETA
#
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha os valores obrigatórios (marcados com OBRIGATÓRIO)
# 3. Configure pelo menos UMA api key de IA
# 4. Nunca commite o arquivo .env
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# 🔑 DISCORD (OBRIGATÓRIO)
# ──────────────────────────────────────────────────────────────
# Token do bot — Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# ID da aplicação — Developer Portal > General Information
CLIENT_ID=

# ID do servidor para registrar comandos na inicialização
GUILD_ID=

# ──────────────────────────────────────────────────────────────
# 👑 DONO DO BOT (IMPORTANTE)
# ──────────────────────────────────────────────────────────────
# Ative o Modo Desenvolvedor, clique direito no seu usuário > Copiar ID
OWNER_ID=
OWNER_NAME=Mestre

# ──────────────────────────────────────────────────────────────
# 🤖 INTELIGÊNCIA ARTIFICIAL (Configure pelo menos uma!)
# ──────────────────────────────────────────────────────────────

# Google Gemini — RECOMENDADO (gratuito)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# OpenAI GPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ordem de prioridade dos provedores (separado por vírgula)
# O bot tentará cada um na ordem caso o anterior falhe
AI_PRIORITY=gemini,anthropic,openai

# ──────────────────────────────────────────────────────────────
# 🎭 PERSONALIDADE DO BOT
# ──────────────────────────────────────────────────────────────
BOT_NAME=Miku

# Quem o bot é — escreva em texto livre como se estivesse descrevendo
# a personalidade para alguém. Sem bullet points, sem templates.
# Quanto mais natural e específico, melhor o resultado.
# Deixe vazio para usar a personalidade padrão.
#
# Exemplo:
# BOT_PERSONALITY=Você é Sakura, uma ex-delinquente que virou idol por acidente.
# Fala de forma brusca mas no fundo se importa muito com o servidor.
# Não sabe receber elogios e fica vermelha (em texto). Adora rap e odeiam manhã.
BOT_PERSONALITY=

# Contexto do mundo/servidor onde o bot existe — injeta nas respostas
# para dar identidade de onde ele "mora". Opcional mas faz diferença.
# Exemplo: "Servidor de uma comunidade de desenvolvedores brasileiros"
# Exemplo: "Servidor do clã X de Valorant, galera competitiva e engraçada"
BOT_CONTEXT=

# Estilo de humor padrão (quando BOT_PERSONALITY está vazio)
# Opções: default | roast | chill | tsundere
# - default:   mix equilibrado, situacional, imprevisível
# - roast:     sarcástico, ácido, humor direto
# - chill:     descolado, seco, direto ao ponto
# - tsundere:  dramático, finge não se importar, humor involuntário
BOT_HUMOR_STYLE=default

# ──────────────────────────────────────────────────────────────
# ⚙️ CONFIGURAÇÕES AVANÇADAS
# ──────────────────────────────────────────────────────────────

# Máximo de tokens na resposta (maior = respostas mais longas, mais caro)
AI_MAX_TOKENS=1000

# Temperatura da IA: 0.1 = focado/determinístico | 1.0 = criativo/aleatório
AI_TEMPERATURE=0.8

# Máximo de mensagens mantidas no histórico por canal
MAX_HISTORY=30

# Cooldown padrão entre usos do mesmo comando (em segundos)
DEFAULT_COOLDOWN=3

# ──────────────────────────────────────────────────────────────
# 🎨 CORES DOS EMBEDS (Hexadecimal sem #)
# ──────────────────────────────────────────────────────────────
COLOR_PRIMARY=5865F2
COLOR_SUCCESS=57F287
COLOR_ERROR=ED4245
COLOR_WARNING=FEE75C
COLOR_INFO=5865F2

# ──────────────────────────────────────────────────────────────
# 📝 LOGS
# ──────────────────────────────────────────────────────────────
# ID do canal do Discord para receber logs de erro (opcional)
LOG_CHANNEL_ID=

# Habilita logs detalhados no console (true/false)
DEBUG_MODE=false
